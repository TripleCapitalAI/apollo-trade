# Apollo.Trade - Client Environment Configuration Example
# Duplicate this file as '.env.local' or set these variables in your hosting provider (Vercel/Netlify).

# Primary OpenAI API Key (or compatible LLM provider e.g. OpenRouter, DeepSeek)
# Used as the default fallback key when clients have not bound their own Privy/Web3 keys.
VITE_DEFAULT_API_KEY=your_openai_api_key_here
